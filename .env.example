# 路书环境变量示例。复制为 .env.local 后填写，.env.local 不会进版本库。
#
# 变量名与 third_party/floattrip 内的引擎保持一致，
# 这样引擎代码无需修改即可读到同一份配置。

# ─── 高德（实体真源，必填）─────────────────────────────────
# Web 服务 Key：后端调用 POI 搜索、天气用
AMAP_API_KEY=

# Web端(JS API) Key：应用内地图用，后端只下发此 Key，不下发 REST Key
AMAP_JS_KEY=

# JS API 安全密钥，与 JS Key 配套
AMAP_JS_SECURITY_CODE=

# ─── LLM（必填其一）───────────────────────────────────────
# 提供商：deepseek | doubao，默认 deepseek
LLM_PROVIDER=deepseek

DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-v4-flash
# DEEPSEEK_BASE_URL=

# DOUBAO_API_KEY=
# DOUBAO_MODEL=doubao-pro-4k
# DOUBAO_ENDPOINT_ID=

# ─── 路书自有配置（可选）──────────────────────────────────
# 数据目录，默认 <项目根>/data
# LUSHU_DATA_DIR=
# SQLite 主库，默认 <数据目录>/lushu.db
# LUSHU_DB_PATH=
# LangGraph 检查点库，默认 <数据目录>/langgraph-checkpoints.db
# LUSHU_CHECKPOINT_DB=
# 本地服务端口，默认 8756
# LUSHU_PORT=8756

# ─── 可选 ─────────────────────────────────────────────────
# Redis 缓存，留空则禁用（引擎会静默降级，不必安装 redis）
REDIS_URL=

# HTTP 代理
# HTTPS_PROXY=
